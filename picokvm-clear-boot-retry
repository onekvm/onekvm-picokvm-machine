#!/bin/sh
# The initramfs counts every boot in /boot/boot_retry_time.txt; the tenth
# uncleared one enters Recovery. Two minutes after startup this boot counts
# as good, unless OneKVM stopped during that time.
set -eu
boot=${ONEKVM_BOOT_DIR:-/boot}
mountpoint -q "$boot"
systemctl is-active --quiet onekvm.service
[ -e "$boot/boot_retry_time.txt" ] || [ -L "$boot/boot_retry_time.txt" ] || exit 0
rm -f "$boot/boot_retry_time.txt"
sync
